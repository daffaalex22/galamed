---
import { site } from '../data/site';
---
<div class="rounded-2xl bg-navy-900 p-8 text-white md:p-12">
  <h2 class="text-3xl font-bold tracking-tight">Minta penawaran resmi</h2>
  <p class="mt-2 max-w-xl text-slate-300">
    Isi kebutuhan Anda, lalu klik &ldquo;Kirim via WhatsApp&rdquo; &mdash; WhatsApp akan terbuka dengan pesan yang sudah terisi otomatis. Data tidak dikirim ke situs ini.
  </p>
  <p class="mt-1 text-xs text-slate-400">Kolom bertanda <span aria-hidden="true" class="text-brand-200">*</span> wajib diisi.</p>
  <form id="quote-form" class="mt-6 grid gap-4 md:grid-cols-2">
    <label class="grid gap-1 text-sm">
      <span>Nama <span aria-hidden="true" class="text-brand-200">*</span></span>
      <input
        name="name" required placeholder="mis: Budi Santoso"
        class="min-h-[44px] rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-white placeholder:text-slate-400 focus:border-white/50 focus:outline-none"
      />
    </label>
    <label class="grid gap-1 text-sm">
      Jabatan (opsional)
      <input
        name="jabatan" placeholder="mis: Owner / Purchasing"
        class="min-h-[44px] rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-white placeholder:text-slate-400 focus:border-white/50 focus:outline-none"
      />
    </label>
    <label class="grid gap-1 text-sm">
      <span>Nama instansi / distributor <span aria-hidden="true" class="text-brand-200">*</span></span>
      <input
        name="orgName" required placeholder="mis: RS Umum Bandung / Apotek Sejahtera"
        class="min-h-[44px] rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-white placeholder:text-slate-400 focus:border-white/50 focus:outline-none"
      />
    </label>
    <label class="grid gap-1 text-sm">
      <span>No. HP / email <span aria-hidden="true" class="text-brand-200">*</span></span>
      <input
        name="contact" required placeholder="mis: +62 812-3456-7890"
        class="min-h-[44px] rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-white placeholder:text-slate-400 focus:border-white/50 focus:outline-none"
      />
    </label>
    <label class="grid gap-1 text-sm md:col-span-2">
      <span>Alamat instansi / distributor <span aria-hidden="true" class="text-brand-200">*</span></span>
      <textarea
        name="orgAddress" rows="2" required placeholder="mis: Jl. Merdeka No. 123, Bandung"
        class="rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-white placeholder:text-slate-400 focus:border-white/50 focus:outline-none"
      ></textarea>
    </label>
    <label class="grid gap-1 text-sm md:col-span-2">
      <span>Kebutuhan produk <span aria-hidden="true" class="text-brand-200">*</span></span>
      <textarea
        name="need" rows="3" required placeholder="mis: 100 box Kasa Hidrofil Lipat, 50 roll Kasa Hidrofil Roll — ukuran dan kemasan bisa disesuaikan"
        class="rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-white placeholder:text-slate-400 focus:border-white/50 focus:outline-none"
      ></textarea>
    </label>
    <div class="flex flex-col gap-3 sm:flex-row md:col-span-2">
      <button
        type="submit"
        class="min-h-[44px] min-w-0 flex-1 cursor-pointer rounded-lg bg-wa-500 px-4 py-3 font-bold text-white transition hover:bg-wa-600 hover:shadow-lg hover:shadow-wa-500/25 active:scale-[0.98] sm:px-6"
      >
        <span class="inline-flex items-center justify-center gap-2">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.881-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.464 3.488" />
          </svg>
          Kirim via WhatsApp
        </span>
      </button>
      <a
        href={`mailto:${site.email}`}
        class="min-h-[44px] inline-flex min-w-0 flex-1 items-center justify-center gap-2 rounded-lg border border-white/30 px-4 py-3 text-sm font-semibold transition hover:bg-white/10 hover:border-white/50 sm:px-6 sm:text-base"
      >
        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 9.909a2.25 2.25 0 0 1-1.07-1.916V6.75" />
        </svg>
        <!-- break-all: the email is a 36-char unbreakable word and would push this
             button past the viewport on phones otherwise. -->
        <span class="break-all">{site.email}</span>
      </a>
    </div>
  </form>
  <p class="mt-4 text-sm text-slate-400">Dibalas pada jam kerja ({site.hours}). Telepon/WA: {site.phoneDisplay}</p>
</div>

<script define:vars={{ waNumber: site.waNumber }}>
  const form = document.getElementById('quote-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const lines = [
      `Halo Galamed, saya ${data.get('name')}${data.get('jabatan') ? `, ${data.get('jabatan')}` : ''}.`,
      `Instansi/Distributor: ${data.get('orgName')}`,
      `Kontak: ${data.get('contact')}`,
      `Alamat: ${data.get('orgAddress')}`,
      `Kebutuhan produk:`,
      `${data.get('need')}`,
    ];
    const msg = lines.join('\n');
    window.open(`https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`, '_blank');
  });
</script>
