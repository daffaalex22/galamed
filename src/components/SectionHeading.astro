---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
}
const { eyebrow, title, desc } = Astro.props;
---
<div class="max-w-3xl">
  <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-700">{eyebrow}</p>
  <h2 class="mt-2 text-3xl font-bold tracking-tight md:text-4xl">{title}</h2>
  {desc && <p class="mt-3 text-slate-600">{desc}</p>}
</div>
