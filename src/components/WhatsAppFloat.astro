---
interface Props {
  waLink: string;
}
const { waLink } = Astro.props;
---
<a
  href={waLink}
  target="_blank"
  rel="noopener"
  aria-label="Chat WhatsApp Galamed"
  class="fixed bottom-6 right-6 z-50 inline-flex min-h-[52px] min-w-[52px] items-center justify-center rounded-full bg-green-500 px-5 py-3 text-base font-bold text-white shadow-xl transition hover:-translate-y-1 hover:bg-green-600 hover:shadow-2xl active:translate-y-0"
>
  WA
</a>
