---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Override for detail pages: site-absolute or root-relative image URL. */
  ogImage?: string;
}
const {
  title = 'Galamed - Distributor Kasa Hidrofil & Konsumabel Medis',
  description = 'Distributor kasa hidrofil dari PT Galunggung Perkasa Husada (memegang IDAK & sertifikat CDAKB) untuk rumah sakit, apotek, dan distributor. Minta penawaran via WhatsApp.',
  ogImage = 'https://galamed.id/legacy/ss-galamed.webp',
} = Astro.props;
// Izin Distribusi Alat Kesehatan (IDAK) - PT Galunggung Perkasa Husada, terverifikasi OSS.
// Full certificate: public/images/IDAK PT Galunggung Perkasa Husada.pdf.png
const idakNumber = '23032300096620005';
// Per-page canonical derived from the real URL. A hardcoded '/…' here would
// silently canonicalize every future page (products, articles) to the homepage.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
// Square logo mark — schema.org logo should be a recognizable square-ish mark,
// not a wide banner or page screenshot. Also used as the favicon.
const logoUrl = 'https://galamed.id/legacy/logo-mark.png';

// Site-wide entity graph: the distributing business (LocalBusiness so Google's
// local systems read address/hours/phone) + the WebSite node referencing it.
// Hours are hardcoded to match site.json ("Senin–Jumat 08.00–17.00 WIB").
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': 'https://galamed.id/#organization',
      name: site.company,
      alternateName: site.brand,
      // The organization node is shared across all pages via @id, so its url
      // must be a single stable value (the homepage) — not the per-page
      // canonical, which would make the same entity claim a different URL
      // on every product page.
      url: 'https://galamed.id/',
      logo: logoUrl,
      email: site.email,
      telephone: `+${site.waNumber}`,
      description: `Distributor alat kesehatan resmi (IDAK No. ${idakNumber}): kasa hidrofil lengkap untuk fasilitas kesehatan & distributor.`,
      ...(site.address
        ? {
            address: {
              '@type': 'PostalAddress',
              streetAddress: site.address,
              addressCountry: 'ID',
            },
          }
        : {}),
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '08:00',
          closes: '17:00',
        },
      ],
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'sales',
          telephone: `+${site.waNumber}`,
          email: site.email,
          availableLanguage: 'id',
        },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://galamed.id/#website',
      url: 'https://galamed.id/',
      name: site.brand,
      inLanguage: 'id-ID',
      publisher: { '@id': 'https://galamed.id/#organization' },
    },
  ],
};
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#101b4d" />

    <!-- Open Graph: pretty preview when shared on WhatsApp / social -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Galamed" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Machine-readable briefs for AI agents (llmstxt.org). Linked here because
         discovery files are only fetched when something points to them. -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Ringkasan Galamed untuk AI (llms.txt)" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Isi lengkap situs Galamed untuk AI (llms-full.txt)" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Google Search Console: paste your verification code here after creating the property.
         Search Console → Settings → Verification → HTML tag → copy content="..." value. -->
    <!-- <meta name="google-site-verification" content="PASTE_CODE_HERE" /> -->

    <!-- GA4: replace G-XXXXXXX with your Measurement ID (Admin → Data Streams), then uncomment.
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXX');
    </script>
    -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <!-- Favicon set at permanent root URLs. Google reads the favicon only from
         the home page's <head> and caches it per hostname (galamed.id's home
         page), and many crawlers fetch /favicon.ico even without a link tag —
         so regenerate files instead of renaming (npm run favicons). -->
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body class="bg-white text-slate-900 antialiased">
    <Navbar brand={site.brand} waLink={site.waLink} />
    <slot />
    <footer class="bg-navy-900 text-slate-300">
      <div class="mx-auto max-w-6xl px-6 py-12">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1.1fr_1.2fr]">
          <div>
            <a href="/" class="inline-flex rounded-xl bg-white px-4 py-2 shadow-sm" aria-label="Ke beranda">
              <img src="/legacy/logo-galamed.png" alt="Galamed" width="1471" height="287" class="h-8 w-auto object-contain" loading="lazy" />
            </a>
            <p class="mt-4 max-w-xs text-sm leading-relaxed text-slate-400">
              Distributor konsumabel medis resmi dari {site.company}.
              Kasa hidrofil lengkap untuk fasilitas kesehatan dan distributor.
              Memegang Izin Distribusi Alat Kesehatan (IDAK) &amp; Sertifikat CDAKB.
            </p>
          </div>
          <nav aria-label="Tautan cepat">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-200">Tautan cepat</p>
            <!-- Root-relative paths (not bare #anchors): the anchors only exist on
                 the homepage, so on product pages these would be dead links. -->
            <ul class="mt-4 grid gap-2 text-sm">
              <li><a href="/" class="text-slate-300 transition hover:text-brand-200">Beranda</a></li>
              <li><a href="/#about" class="text-slate-300 transition hover:text-brand-200">Tentang kami</a></li>
              <li><a href="/#products" class="text-slate-300 transition hover:text-brand-200">Produk</a></li>
              <li><a href="/#layanan" class="text-slate-300 transition hover:text-brand-200">Layanan</a></li>
              <li><a href="/#contact" class="text-slate-300 transition hover:text-brand-200">Hubungi kami</a></li>
              <li><a href="/llms.txt" class="text-slate-300 transition hover:text-brand-200" target="_blank" rel="noopener">Galamed untuk AI</a></li>
            </ul>
          </nav>
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-200">Kontak</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li><a href={`mailto:${site.email}`} class="break-all text-slate-300 transition hover:text-brand-200">{site.email}</a></li>
              <li><a href={`tel:+${site.waNumber}`} class="text-slate-300 transition hover:text-brand-200">{site.phoneDisplay}</a></li>
              <li><a href={site.waLink} target="_blank" rel="noopener" class="text-slate-300 transition hover:text-brand-200">Chat via WhatsApp</a></li>
            </ul>
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-200">Perusahaan</p>
            <p class="mt-4 text-sm font-semibold text-white">{site.company}</p>
            {site.address && <p class="mt-1 text-sm leading-relaxed text-slate-400">{site.address}</p>}
            <p class="mt-3 text-sm text-slate-400">Jam layanan: {site.hours}</p>
          </div>
        </div>
        <div class="mt-12 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between">
          <span>&copy; {new Date().getFullYear()} {site.company} &middot; {site.brand}</span>
          <span>{site.tagline}</span>
        </div>
      </div>
    </footer>
    <WhatsAppFloat waLink={site.waLink} />
  </body>
</html>
