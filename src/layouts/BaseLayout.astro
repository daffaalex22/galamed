---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Galamed: Distributor Alat Kesehatan Premium | PT Galunggung Perkasa Husada',
  description = 'Distributor alat kesehatan premium di bawah PT Galunggung Perkasa Husada (Galamed): kasa steril, kasa lipat, dan consumables klinis standar internasional. Minta penawaran via WhatsApp.',
} = Astro.props;
const canonical = 'https://galamed.id/';
const ogImage = 'https://galamed.id/legacy/ss-galamed.webp';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.company,
  alternateName: site.brand,
  url: canonical,
  logo: ogImage,
  email: site.email,
  telephone: `+${site.waNumber}`,
  description: 'Distributor konsumabel medis resmi: kasa steril, kapas, dan perawatan luka.',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      telephone: `+${site.waNumber}`,
      email: site.email,
      availableLanguage: 'id',
    },
  ],
  ...(site.address
    ? {
        address: {
          '@type': 'PostalAddress',
          streetAddress: site.address,
          addressCountry: 'ID',
        },
      }
    : {}),
};
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#101b4d" />

    <!-- Open Graph: pretty preview when shared on WhatsApp / social -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Galamed" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Google Search Console: paste your verification code here after creating the property.
         Search Console → Settings → Verification → HTML tag → copy content="..." value. -->
    <!-- <meta name="google-site-verification" content="PASTE_CODE_HERE" /> -->

    <!-- GA4: replace G-XXXXXXX with your Measurement ID (Admin → Data Streams), then uncomment.
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXX');
    </script>
    -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/legacy/Logo%20Galamed%20No%20Text.png" />
  </head>
  <body class="bg-white text-slate-900 antialiased">
    <Navbar brand={site.brand} waLink={site.waLink} />
    <slot />
    <footer class="bg-navy-900 text-slate-300">
      <div class="mx-auto max-w-6xl px-6 py-12">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1.1fr_1.2fr]">
          <div>
            <a href="#home" class="inline-flex rounded-xl bg-white px-4 py-2 shadow-sm" aria-label="Ke beranda">
              <img src="/legacy/logo-galamed.png" alt="Galamed" width="1471" height="287" class="h-8 w-auto object-contain" loading="lazy" />
            </a>
            <p class="mt-4 max-w-xs text-sm leading-relaxed text-slate-400">
              Distributor konsumabel medis resmi di bawah {site.company}.
              Kasa steril, kapas, dan perawatan luka untuk instansi medis dan distributor.
            </p>
          </div>
          <nav aria-label="Tautan cepat">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-200">Tautan Cepat</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li><a href="#home" class="text-slate-300 transition hover:text-brand-200">Beranda</a></li>
              <li><a href="#about" class="text-slate-300 transition hover:text-brand-200">Tentang Kami</a></li>
              <li><a href="#products" class="text-slate-300 transition hover:text-brand-200">Produk</a></li>
              <li><a href="#layanan" class="text-slate-300 transition hover:text-brand-200">Layanan</a></li>
              <li><a href="#contact" class="text-slate-300 transition hover:text-brand-200">Hubungi Kami</a></li>
            </ul>
          </nav>
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-200">Kontak</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li><a href={`mailto:${site.email}`} class="text-slate-300 transition hover:text-brand-200">{site.email}</a></li>
              <li><a href={`tel:+${site.waNumber}`} class="text-slate-300 transition hover:text-brand-200">{site.phoneDisplay}</a></li>
              <li><a href={site.waLink} target="_blank" rel="noopener" class="text-slate-300 transition hover:text-brand-200">Chat via WhatsApp</a></li>
            </ul>
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-200">Perusahaan</p>
            <p class="mt-4 text-sm font-semibold text-white">{site.company}</p>
            {site.address && <p class="mt-1 text-sm leading-relaxed text-slate-400">{site.address}</p>}
            <p class="mt-3 text-sm text-slate-400">Jam layanan: {site.hours}</p>
          </div>
        </div>
        <div class="mt-12 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between">
          <span>&copy; {new Date().getFullYear()} {site.company} &middot; {site.brand}</span>
          <span>{site.tagline}</span>
        </div>
      </div>
    </footer>
    <WhatsAppFloat waLink={site.waLink} />
  </body>
</html>
