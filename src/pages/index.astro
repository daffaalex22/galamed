---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductCard from '../components/ProductCard.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const entries = await getCollection('products');
const products = [...entries]
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((e) => ({ ...e.data, slug: e.id.replace(/^\d+-/, '') }));

const categories = ['Semua', ...new Set(products.map((p) => p.category))];

// Catalog schema: tells Google the page lists these products, each with its
// own detail page (Product nodes are fully marked up on the detail pages).
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Katalog produk konsumabel medis Galamed',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.name,
      url: new URL(`/produk/${p.slug}/`, Astro.site).href,
      image: new URL(p.image, Astro.site).href,
      category: p.category,
      brand: { '@type': 'Brand', name: site.brand },
    },
  })),
};

// Homepage FAQ: company/purchasing-level questions only (product-level FAQs
// live on the detail pages — no duplicated content across pages). Every answer
// below is verifiable from site facts (IDAK/CDAKB, jam layanan, alamat) —
// nothing here may claim steril status, coverage area, prices, or minimum
// quantities until the client confirms them in writing.
const faq = [
  {
    q: 'Apakah Galamed distributor alat kesehatan resmi?',
    a: 'Ya. Galamed adalah merek distribusi dari PT Galunggung Perkasa Husada, pemegang Izin Distribusi Alat Kesehatan (IDAK No. 23032300096620005, terverifikasi OSS) dan Sertifikat CDAKB. Kedua dokumen bisa dilihat dan dibuka satu per satu di bagian "Tentang kami" di atas.',
  },
  {
    q: 'Bagaimana cara meminta penawaran?',
    a: 'Klik tombol WhatsApp di situs ini atau isi formulir "Minta penawaran resmi" — WhatsApp akan terbuka dengan pesan yang sudah terisi otomatis. Penawaran resmi dikirim pada jam layanan: Senin–Jumat 08.00–17.00 WIB.',
  },
  {
    q: 'Apakah ada minimal order?',
    a: 'Kebutuhan setiap pembeli berbeda — rumah sakit, klinik, puskesmas, apotek, dan distributor tidak memesan dalam jumlah yang sama. Sampaikan perkiraan kebutuhan Anda via WhatsApp, lalu kami susun penawarannya.',
  },
  {
    q: 'Bisakah memesan ukuran atau kemasan khusus?',
    a: 'Bisa. Ukuran dan isi kemasan bisa dibuat menyesuaikan pesanan Anda — sampaikan spesifikasinya saat konsultasi awal via WhatsApp atau email.',
  },
  {
    q: 'Bagaimana pengirimannya?',
    a: 'Pesanan dikirim dengan dokumentasi lengkap sampai barang diterima di lokasi Anda. Untuk cakupan area dan estimasi waktu pengiriman, konfirmasikan bersama kebutuhan Anda via WhatsApp.',
  },
  {
    q: 'Di mana kantor Galamed berada?',
    a: `Kami berada di ${site.address}. Alamat lengkap dan kontak juga tercantum di bagian bawah setiap halaman situs ini.`,
  },
];

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
  <header id="home" class="bg-brand-50">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-16 md:py-24 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">
      <div>
        <h1 class="max-w-xl text-4xl font-extrabold leading-tight tracking-tight text-navy-800 md:text-5xl">
          Kasa hidrofil lengkap untuk fasilitas kesehatan &amp; distributor
        </h1>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-slate-600">
          Galamed adalah merek distribusi dari PT Galunggung Perkasa Husada,
          yang memegang Izin Distribusi Alat Kesehatan (IDAK) dan Sertifikat CDAKB.
          Kami menyediakan kasa hidrofil lengkap dengan kemasan besar
          untuk rumah sakit, klinik, puskesmas, apotek, dan distributor: mulai dari konsultasi
          kebutuhan, penawaran resmi, hingga pengiriman terdokumentasi,
          semuanya bisa dimulai lewat WhatsApp.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={site.waLink}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-brand-700 px-6 py-3 font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-brand-800 hover:shadow-md"
          >
            Minta penawaran via WhatsApp
          </a>
          <a
            href="#products"
            class="inline-flex min-h-[44px] items-center justify-center rounded-lg border-2 border-brand-700 bg-transparent px-6 py-3 font-semibold text-brand-700 transition hover:bg-white"
          >
            Lihat katalog
          </a>
        </div>
        <ul class="mt-8 flex flex-col gap-2 text-sm text-slate-600 sm:flex-row sm:flex-wrap sm:gap-x-6">
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 shrink-0 text-brand-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
            </svg>
            Ukuran &amp; kemasan bisa menyesuaikan pesanan
          </li>
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 shrink-0 text-brand-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
            </svg>
            Penawaran resmi dibalas pada jam kerja
          </li>
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 shrink-0 text-brand-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
            </svg>
            Pengiriman aman &amp; terdokumentasi
          </li>
        </ul>
      </div>
      <div class="mt-12 lg:mt-0">
        <figure class="relative overflow-hidden rounded-3xl border border-brand-100 bg-gradient-to-b from-white to-brand-100/60 shadow-sm">
          <img
            src="/images/products/kasa-hidrofil-lipat.jpg"
            alt="Kasa Hidrofil Lipat produksi Galamed"
            width="700"
            height="700"
            fetchpriority="high"
            class="h-72 w-full object-contain p-10 md:h-[26rem]"
          />
          <figcaption class="absolute inset-x-4 bottom-4 flex flex-col gap-2 rounded-xl bg-white/85 px-4 py-3 shadow-sm backdrop-blur sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-sm font-semibold text-navy-800">Kasa Hidrofil Lipat</p>
              <p class="text-xs text-slate-500">1 dari {products.length} produk konsumabel medis kami</p>
            </div>
            <a href="#products" class="text-sm font-semibold text-brand-700">
              Lihat katalog &rarr;
            </a>
          </figcaption>
        </figure>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-6xl space-y-20 px-6 py-16">
    <section id="about" class="scroll-mt-24">
      <div class="grid items-center gap-10 md:grid-cols-[1fr_320px] lg:gap-12">
        <div>
          <SectionHeading eyebrow="Tentang kami" title="Legalitas yang bisa diverifikasi" desc="Galamed adalah merek distribusi dari PT Galunggung Perkasa Husada, dengan izin distribusi alat kesehatan resmi dan Sertifikat Cara Distribusi yang Baik (CDAKB). Nomor izin tercantum di bawah ini untuk keperluan verifikasi pengadaan." />
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            <a
              href="/images/IDAK%20PT%20Galunggung%20Perkasa%20Husada.pdf.png"
              target="_blank"
              rel="noopener"
              aria-label="Buka sertifikat IDAK asli (gambar penuh)"
              title="Buka sertifikat IDAK asli (gambar penuh)"
              class="group block"
            >
              <span class="block overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition duration-300 group-hover:-translate-y-1 group-hover:shadow-md">
                <img
                  src="/images/deriv/idak-top.webp"
                  alt="Halaman atas sertifikat IDAK PT Galunggung Perkasa Husada"
                  width="640"
                  height="407"
                  loading="lazy"
                  class="w-full"
                />
              </span>
              <span class="mt-3 block text-sm font-semibold text-navy-800 transition-colors group-hover:text-brand-700">Izin Distribusi Alat Kesehatan (IDAK)</span>
              <span class="mt-1 block font-mono text-xs tabular-nums tracking-wide text-slate-600">No. 23032300096620005</span>
            </a>
            <a
              href="/images/CDB-CDAKB%20PT%20Galunggung%20Perkasa%20Husada.pdf.png"
              target="_blank"
              rel="noopener"
              aria-label="Buka sertifikat CDAKB asli (gambar penuh)"
              title="Buka sertifikat CDAKB asli (gambar penuh)"
              class="group block"
            >
              <span class="block overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition duration-300 group-hover:-translate-y-1 group-hover:shadow-md">
                <img
                  src="/images/deriv/cdakb-top.webp"
                  alt="Halaman atas sertifikat Cara Distribusi yang Baik PT Galunggung Perkasa Husada"
                  width="640"
                  height="407"
                  loading="lazy"
                  class="w-full"
                />
              </span>
              <span class="mt-3 block text-sm font-semibold text-navy-800 transition-colors group-hover:text-brand-700">Sertifikat Cara Distribusi yang Baik (CDAKB)</span>
              <span class="mt-1 block font-mono text-xs tabular-nums tracking-wide text-slate-600">No. PB UMKU 230323000966200050001</span>
            </a>
          </div>
          <p class="mt-4 text-xs text-slate-500">Klik gambar untuk membuka dokumen asli.</p>
          <p class="mt-6 text-sm leading-relaxed text-slate-600">
            Nomor Induk Berusaha <strong class="font-semibold text-navy-800">(NIB) 2303230009662</strong>, terdaftar di sistem OSS dan berstatus telah terverifikasi.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
          <img src="/legacy/logo-gph.webp" alt="PT Galunggung Perkasa Husada logo" width="637" height="622" class="mx-auto h-40 w-40 rounded-full object-cover" loading="lazy" />
          <p class="mt-4 text-sm font-semibold text-navy-800">{site.company}</p>
          <p class="mt-1 text-xs text-slate-500">Terdaftar pada sistem OSS sejak 2023</p>
        </div>
      </div>
    </section>

    <section id="products" class="scroll-mt-24">
      <SectionHeading eyebrow="Katalog" title="Produk konsumabel medis" desc="Kasa hidrofil lengkap dalam semua bentuk: lipat, lembaran, roll, roll gauze, depper, tampon, hingga big gauze. Ukuran dan isi kemasan bisa dibuat menyesuaikan pesanan Anda." />
      <div class="mt-6 flex flex-col gap-3 md:flex-row md:items-center">
        <input
          id="product-search"
          type="search"
          placeholder="Cari produk… (mis: roll gauze)"
          class="min-h-[44px] w-full rounded-lg border border-slate-300 px-4 py-2 text-base focus:border-brand-500 focus:outline-none md:max-w-sm"
        />
        {categories.length > 2 && (
          <div id="product-filters" class="flex flex-wrap gap-2">
            {categories.map((c, i) => (
              <button
                data-cat={c}
                class={`min-h-[44px] rounded-full border px-4 py-2 text-sm font-semibold transition ${i === 0 ? 'border-brand-700 bg-brand-700 text-white' : 'border-slate-300 text-navy-800 hover:border-brand-700 hover:text-brand-700'}`}
              >
                {c}
              </button>
            ))}
          </div>
        )}
      </div>
      <p id="product-count" class="mt-3 text-sm text-slate-500" aria-live="polite"></p>
      <div id="product-grid" class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {products.map((p) => (
          <div data-name={p.name.toLowerCase()} data-cat={p.category}>
            <ProductCard product={p} />
          </div>
        ))}
      </div>
      <p id="product-empty" class="hidden rounded-xl border border-dashed p-6 text-center text-slate-500">
        Tidak ada produk yang cocok. Coba kata kunci lain atau hubungi kami via WhatsApp.
      </p>
    </section>

    <section id="layanan" class="scroll-mt-24">
      <SectionHeading eyebrow="Layanan" title="Cara pemesanan untuk fasilitas kesehatan & distributor" />
      <ol class="mt-6 grid gap-4 md:grid-cols-4">
        <li class="rounded-xl border p-5"><strong>1. Konsultasi kebutuhan</strong><br /><span class="text-sm text-slate-600">Ceritakan jenis, ukuran, dan jumlah yang Anda butuhkan via WhatsApp atau email; dibalas pada jam kerja.</span></li>
        <li class="rounded-xl border p-5"><strong>2. Penawaran resmi</strong><br /><span class="text-sm text-slate-600">Kami kirimkan penawaran sesuai spesifikasi: ukuran dan isi kemasan bisa dibuat menyesuaikan pesanan Anda.</span></li>
        <li class="rounded-xl border p-5"><strong>3. Pengiriman terdokumentasi</strong><br /><span class="text-sm text-slate-600">Pesanan dikirim aman dengan dokumentasi lengkap sampai barang diterima di lokasi Anda.</span></li>
        <li class="rounded-xl border p-5"><strong>4. Dukungan lanjutan</strong><br /><span class="text-sm text-slate-600">Pertanyaan produk atau pesanan berikutnya bisa dilanjutkan lewat jalur yang sama.</span></li>
      </ol>
    </section>

    <section id="faq" class="scroll-mt-24">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] lg:gap-12">
        <div class="self-start lg:sticky lg:top-24">
          <SectionHeading
            eyebrow="FAQ"
            title="Pertanyaan yang sering diajukan"
            desc="Belum menemukan jawaban yang dicari? Hubungi kami via WhatsApp — dibalas pada jam kerja."
          />
        </div>
        <div class="divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white shadow-sm">
          {faq.map((item) => (
            <details class="group px-5">
              <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-4 font-semibold text-navy-800 transition-colors [&::-webkit-details-marker]:hidden hover:text-brand-700">
                {item.q}
                <svg class="h-4 w-4 shrink-0 text-brand-700 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M10 3a1 1 0 0 1 1 1v5h5a1 1 0 1 1 0 2h-5v5a1 1 0 1 1-2 0v-5H4a1 1 0 1 1 0-2h5V4a1 1 0 0 1 1-1Z" />
                </svg>
              </summary>
              <p class="pb-5 text-sm leading-relaxed text-slate-600">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="scroll-mt-24">
      <QuoteForm waLink={site.waLink} />
    </section>
  </main>
</BaseLayout>

<script>
  const search = document.getElementById('product-search');
  const buttons = [...document.querySelectorAll('#product-filters button')];
  const cards = [...document.querySelectorAll('#product-grid > div')];
  const count = document.getElementById('product-count');
  const empty = document.getElementById('product-empty');
  let activeCat = 'Semua';

  function apply() {
    const q = (search?.value ?? '').toLowerCase().trim();
    let shown = 0;
    cards.forEach((el) => {
      const matchCat = activeCat === 'Semua' || el.dataset.cat === activeCat;
      const matchQ = !q || el.dataset.name?.includes(q);
      const show = matchCat && matchQ;
      el.classList.toggle('hidden', !show);
      if (show) shown++;
    });
    if (count) count.textContent = `${shown} dari ${cards.length} produk`;
    empty?.classList.toggle('hidden', shown > 0);
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      activeCat = b.dataset.cat ?? 'Semua';
      buttons.forEach((x) => {
        const on = x === b;
        x.className = `min-h-[44px] rounded-full border px-4 py-2 text-sm font-semibold transition ${on ? 'border-brand-700 bg-brand-700 text-white' : 'border-slate-300 text-navy-800 hover:border-brand-700 hover:text-brand-700'}`;
      });
      apply();
    })
  );
  search?.addEventListener('input', apply);
  apply();
</script>
