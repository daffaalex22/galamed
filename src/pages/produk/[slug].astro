---
// One template -> one page per product in src/content/products/.
// New products added via Decap CMS get a page automatically on the next build.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { site } from '../../data/site';
import { getCollection, render } from 'astro:content';

// File names are NN-product-name.md (sorted, CMS rule: never rename existing
// files), so the URL slug drops the leading "NN-" prefix. NOTE: this helper is
// duplicated inside getStaticPaths — Astro hoists that function into its own
// scope, so it cannot call top-level helpers.
const slugOf = (id: string) => id.replace(/^\d+-/, '');

export async function getStaticPaths() {
  const entries = await getCollection('products');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/^\d+-/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const product = entry.data;
const slug = slugOf(entry.id);

// Hub-and-spoke: every detail page links back to the catalog and to the
// other products (spoke-to-spoke), so nothing is orphaned.
const related = (await getCollection('products'))
  .filter((e) => e.id !== entry.id)
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((e) => ({ ...e.data, slug: slugOf(e.id) }));

const title = `${product.name} — Distributor & Penawaran Resmi | Galamed`;
const description = `${product.short} Distributor resmi ber-IDAK & Sertifikat CDAKB untuk rumah sakit, klinik, apotek, dan distributor. Ukuran & kemasan menyesuaikan pesanan — minta penawaran via WhatsApp.`;

// FAQ is shown as visible content; FAQPage schema is added only after the
// client verifies the answers (wrong medical claims are worse than none).
const faq = [
  {
    q: `Berapa minimal pesanan untuk ${product.name}?`,
    a: 'Pesanan fleksibel sesuai kebutuhan fasilitas Anda. Untuk skala rumah sakit maupun distributor, konsultasikan jumlah dan kemasannya langsung via WhatsApp — penawaran resmi dikirim pada jam kerja.',
  },
  {
    q: `Apakah ${product.name} bisa dibuat dengan ukuran atau kemasan khusus?`,
    a: 'Bisa. Ukuran dan isi kemasan bisa dibuat menyesuaikan pesanan Anda. Sampaikan spesifikasi yang dibutuhkan saat konsultasi awal.',
  },
  {
    q: 'Apakah Galamed memiliki izin distribusi resmi?',
    a: `Ya. Kami merek distribusi dari ${site.company}, pemegang Izin Distribusi Alat Kesehatan (IDAK) dan Sertifikat CDAKB — nomor izin tercantum dan bisa diverifikasi di halaman beranda.`,
  },
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.desc,
  image: new URL(product.image, Astro.site).href,
  category: product.category,
  brand: { '@type': 'Brand', name: site.brand },
  manufacturer: { '@type': 'Organization', name: site.company },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Produk', item: new URL('/#products', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: product.name },
  ],
};
---

<BaseLayout title={title} description={description} ogImage={product.image}>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main class="mx-auto max-w-6xl px-6 py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="transition hover:text-brand-700">Beranda</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/#products" class="transition hover:text-brand-700">Produk</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-navy-800">{product.name}</li>
      </ol>
    </nav>

    <article class="mt-8 grid items-start gap-10 lg:grid-cols-[1fr_1.2fr]">
      <figure class="overflow-hidden rounded-3xl border border-brand-100 bg-gradient-to-b from-brand-50/80 via-white to-white p-8 shadow-sm">
        <img
          src={product.image}
          alt={product.name}
          width="700"
          height="700"
          fetchpriority="high"
          class="mx-auto aspect-square w-full max-w-md object-contain"
        />
        <figcaption class="mt-4 flex items-center justify-center">
          <span class="rounded-full bg-brand-50 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-brand-800">
            {product.category}
          </span>
        </figcaption>
      </figure>

      <div>
        <h1 class="text-4xl font-extrabold tracking-tight text-navy-800">{product.name}</h1>
        <p class="mt-3 text-lg font-medium text-brand-800">{product.short}</p>
        <div class="prose-galamed mt-6">
          <Content />
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={site.waLink}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-brand-700 px-6 py-3 font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-brand-800 hover:shadow-md"
          >
            Minta penawaran {product.name}
          </a>
          <a
            href="/#products"
            class="inline-flex min-h-[44px] items-center justify-center rounded-lg border-2 border-brand-700 bg-transparent px-6 py-3 font-semibold text-brand-700 transition hover:bg-white"
          >
            Lihat semua produk
          </a>
        </div>
      </div>
    </article>

    <section class="mt-16 scroll-mt-24" aria-label="Pertanyaan umum">
      <SectionHeading eyebrow="FAQ" title="Pertanyaan umum" />
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {faq.map((item) => (
          <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="font-semibold leading-snug text-navy-800">{item.q}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.a}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-16 scroll-mt-24" aria-label="Produk lainnya">
      <SectionHeading
        eyebrow="Katalog"
        title="Produk lainnya"
        desc="Kebutuhan kasa hidrofil lainnya? Semua ukuran dan kemasan bisa menyesuaikan pesanan Anda."
      />
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Minimal typography for the CMS-edited markdown body
     (Tailwind typography plugin is not installed; keep it lean). */
  .prose-galamed :global(h2) {
    margin-top: 1.75rem;
    font-size: 1.25rem;
    line-height: 1.4;
    font-weight: 700;
    color: var(--color-navy-800, #101b4d);
  }
  .prose-galamed :global(p) {
    margin-top: 0.75rem;
    line-height: 1.7;
    color: var(--color-slate-600, #475569);
  }
  .prose-galamed :global(ul) {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.375rem;
    padding-left: 1.25rem;
    list-style: disc;
    color: var(--color-slate-600, #475569);
  }
  .prose-galamed :global(strong) {
    color: var(--color-navy-800, #101b4d);
  }
</style>
